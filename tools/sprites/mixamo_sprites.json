    { "key": "warrok", "name": "Warrok W Kurniawan", "src": "../art_source/mixamo/warrok", "out": "assets/monsters/warrok.png", "canvas": 768, "targetZ": 1.2 },
    { "key": "goblin", "name": "Goblin D Shareyko", "src": "../art_source/mixamo/goblin", "out": "assets/monsters/goblin.png" },
    { "key": "demon", "name": "Demon T Wiezzorek", "src": "../art_source/mixamo/demon", "out": "assets/monsters/demon.png" },
    { "key": "skeletonzombie", "name": "Skeletonzombie T Avelange", "src": "../art_source/mixamo/skeletonzombie", "out": "assets/monsters/skeletonzombie.png" }
