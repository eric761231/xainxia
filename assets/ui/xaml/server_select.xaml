<?xml version="1.0" encoding="utf-8"?>

<UiView id="serverSelect" designWidth="1920" designHeight="1080">
  <InkFadeRect id="panel"
               centerX="960" centerY="470" width="760" height="520"
               color="{ink}" centerOpacity="0"
               fadeX="{fadeX}" fadeY="{fadeY}" radius="0" />

  <Text id="title" text="選擇伺服器" centerX="960" centerY="250"
        size="24" color="#FFFFFF" />

  <Text id="refreshing" text="更新中…" centerX="960" centerY="300"
        size="{fontCaption}" color="#FFFFFF" />

  
  <List id="grid" centerX="960" centerY="440" width="660" height="280"
        columns="1" itemHeight="44" rowGap="2" colGap="16"
        nameSize="{fontBody}" statusSize="{fontCaption}" countSize="{fontCaption}"
        nameColor="#FFFFFF" countColor="#FFFFFF"
        selectedLineColor="{cyan}" selectedLineWidth="2"
        selectedGlowColor="{cyan}" selectedGlowBlur="10" selectedGlowOpacity="0"
        disabledOpacity="0.45" />

  <Button id="cancel" text="取消" centerX="840" centerY="660"
          width="180" height="48" textSize="{fontBody}" textColor="#FFFFFF" />

  <Button id="confirm" text="確認" centerX="1080" centerY="660"
          width="180" height="48" textSize="{fontBody}" textColor="#FFFFFF" />
</UiView>

